# Configuración de Base de Datos Relacional (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sakila

# Usuario Administrador (Usado únicamente por scripts de migración, auditoría y laboratorio)
DB_USER=root
DB_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# Usuario de Aplicación con Privilegios Mínimos (Usado por el Pool del servidor Flask)
APP_DB_USER=sakila_app
APP_DB_PASSWORD=CHANGE_ME_APP_PASSWORD

# Parámetros del Pool de Conexiones
DB_POOL_NAME=sakila_pool
DB_POOL_SIZE=10
DB_POOL_TIMEOUT=5

# Configuración de MongoDB (Extensión Híbrida de Catálogo - Parte E)
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=sakila_catalog
MONGO_COLLECTION_FILMS=films
MONGO_TIMEOUT_MS=2000

# Configuración del Servidor Flask
FLASK_DEBUG=False
PORT=5000
LOG_FILE=logs/app.log
