# ==========================================
# Configuración de Base de Datos (MySQL / MariaDB)
# ==========================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sakila
DB_USER=root
DB_PASSWORD=your_root_password_here

# ==========================================
# Configuración del Pool de Conexiones
# ==========================================
DB_POOL_NAME=sakila_pool
DB_POOL_SIZE=10
DB_POOL_TIMEOUT=5

# ==========================================
# Usuario de aplicación (Privilegios Mínimos - Parte B)
# ==========================================
APP_DB_USER=sakila_app
APP_DB_PASSWORD=change_me

# ==========================================
# Configuración de MongoDB (Parte E)
# ==========================================
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=sakila_catalog

# ==========================================
# Configuración del Servidor Flask
# ==========================================
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000

